# Committed on purpose: these are deterministic local test-only values,
# not secrets. Next.js/`@next/env` does not load .env.local when
# NODE_ENV=test, so integration tests read their config from here.
TEST_DATABASE_URL="postgresql://bestdoctordhaka:bestdoctordhaka@localhost:5432/bestdoctordhaka_test?schema=public"
TEST_REDIS_URL="redis://localhost:6379/1"

# Phase 1: repository/service modules use the shared `@/lib/db/prisma`
# singleton, which always reads DATABASE_URL. Pointing it at the test
# database here (rather than injecting a client per call) lets those
# modules be exercised directly in integration tests without special-casing
# them, while staying isolated from the dev database.
DATABASE_URL="postgresql://bestdoctordhaka:bestdoctordhaka@localhost:5432/bestdoctordhaka_test?schema=public"
