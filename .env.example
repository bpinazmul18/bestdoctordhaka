# Copy this file to .env.local and fill in real local values.
# .env.local is gitignored and must never be committed.

# --- PostgreSQL ---
# Local dev database. See README.md for local setup instructions.
DATABASE_URL="postgresql://bestdoctordhaka:bestdoctordhaka@localhost:5432/bestdoctordhaka?schema=public"

# --- Redis ---
# Local dev cache. Run `docker compose up -d` to start Redis locally.
REDIS_URL="redis://localhost:6379/0"

# Integration test values (TEST_DATABASE_URL, TEST_REDIS_URL, and a
# DATABASE_URL pointed at the test database) live in the committed
# .env.test, not here — Next.js does not load .env.local when
# NODE_ENV=test, and these values are deterministic/non-secret local ones.

# --- SEO ---
# Absolute site origin used for canonical URLs, sitemap.xml, and robots.txt.
# Optional locally (defaults to http://localhost:3000); set the real
# production origin when deploying.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Admin Auth ---
# Secret used to sign admin session cookies. Generate a real one with:
#   openssl rand -base64 32
SESSION_SECRET="replace-with-openssl-rand-base64-32-output"

# Used once by `npm run db:seed:admin` to create the first SUPER_ADMIN
# account. Not read anywhere else — safe to unset after seeding.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-strong-local-password"

# --- Cloudflare R2 (doctor profile photos) ---
# Create a bucket + API token (Account Home > R2) with read/write access to
# it. R2_PUBLIC_URL is the bucket's public base URL — either the r2.dev dev
# subdomain (enable "Public Development URL" on the bucket) or a custom
# domain you've mapped to it. Public read access must be enabled on the
# bucket; doctor photos are public directory content.
R2_ACCOUNT_ID="replace-with-your-cloudflare-account-id"
R2_ACCESS_KEY_ID="replace-with-your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="replace-with-your-r2-secret-access-key"
R2_BUCKET_NAME="bestdoctordhaka-doctor-photos"
R2_PUBLIC_URL="https://replace-with-your-bucket-public-url"
